# Public DNS name of this server; Caddy gets a TLS certificate for it.
QWB_DOMAIN=quota.example.com

# Generate every value independently with: openssl rand -hex 32
# Keys are per computer. Never reuse the read-only widget key here.
QWB_DEVICE_KEYS_JSON='{"macbook-pro":"replace-with-64-hex-characters","mac-mini":"replace-with-another-64-hex-secret"}'
QWB_WIDGET_KEYS=replace-with-a-third-64-hex-secret

QWB_DEVICE_STALE_SECONDS=180
QWB_LIMIT_STALE_SECONDS=900
# 0 = keep the last event-driven state until the next IDE hook update.
QWB_ACTIVE_STATE_TTL_SECONDS=0
QWB_SIGNATURE_MAX_AGE_SECONDS=300
# Authenticated per-device limit, then unauthenticated per-IP/global shields.
QWB_INGEST_REQUESTS_PER_MINUTE=30
QWB_INGEST_REQUESTS_PER_IP_MINUTE=90
QWB_GLOBAL_INGEST_REQUESTS_PER_MINUTE=600
QWB_WIDGET_REQUESTS_PER_IP_MINUTE=120

# Devices that only supply limits (the server poller); kept out of the laptops list.
QWB_LIMIT_SOURCE_DEVICES=server-poller
