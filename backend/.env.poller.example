# /opt/quota-watch-bridge/.env.poller on the server (chmod 600). Never commit the real file.
# Device key of the poller; the same value goes into QWB_DEVICE_KEYS_JSON as "server-poller".
QWB_POLLER_SECRET=replace-with-64-hex-characters
QWB_POLLER_DEVICE_ID=server-poller
QWB_POLLER_ACCOUNT_ID=personal
# Each Claude poll starts Claude Code (~1 s CPU); raise this on a small server if needed.
QWB_POLL_CODEX_SECONDS=15
QWB_POLL_CLAUDE_SECONDS=15
